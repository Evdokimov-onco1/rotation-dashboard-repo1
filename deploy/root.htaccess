# Корневой .htaccess поддомена (кладётся деплоем как <webroot>/.htaccess).
# 1) весь HTTP — на HTTPS; 2) /api/* обслуживает api/index.php (свой .htaccess);
# 3) остальные несуществующие пути — на index.html (SPA).

RewriteEngine On

# На Timeweb SSL терминирует прокси, сайт видит HTTP: смотрим X-Forwarded-Proto,
# иначе получается бесконечный редирект (ERR_TOO_MANY_REDIRECTS).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Файл с реквизитами БД лежит в webroot (веб-процессы Timeweb не читают файлы вне папки
# сайта); снаружи по URL он недоступен.
<Files "rotation-config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
